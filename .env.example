# Local configuration for ONE Discord guild + main bot, optional 2 music-only bots.
# TEMPLATE VALUES ONLY. Never commit this file. Replace TOKEN= with your actual main bot token locally.
TOKEN=
GUILD_ID=
OWNER_DISCORD_USER_ID=1080222698443124797

# Discord OAuth for dashboard (the main bot application).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback/discord
PUBLIC_BASE_URL=http://localhost:3000
AUTH_SECRET=

# Postgres connection for local Docker Compose or your own installation.
DATABASE_URL=
# Used by docker-compose.yml to create the database container (compose overrides DATABASE_URL for bot/web).
# Generate a strong password locally, e.g.: openssl rand -base64 24
POSTGRES_USER=aio
POSTGRES_PASSWORD=
POSTGRES_DB=aio

# OPTIONAL additional music-only identities. Main TOKEN is already music player 1.
MUSIC_BOT_2_TOKEN=
MUSIC_BOT_2_CLIENT_ID=
MUSIC_BOT_3_TOKEN=
MUSIC_BOT_3_CLIENT_ID=

# OPTIONAL external audio backend. Music can show Not Configured until filled.
LAVALINK_URL=
LAVALINK_PASSWORD=
# Optional. YouTube blocks most VPS IPs; sign Lavalink in with a BURNER Google account.
# Leave empty on first start, approve the google.com/device code shown in `docker compose logs lavalink`,
# then paste the refresh token it logs here and restart lavalink. Never use your main account.
YOUTUBE_OAUTH_REFRESH_TOKEN=
# Password between Lavalink and the internal yt-cipher service (both started by the music profile).
# Generate with: openssl rand -hex 32
YT_CIPHER_PASSWORD=
LAVALINK_SECURE=false
# OPTIONAL home music node (docker/home-node): Lavalink on a home internet connection, reached
# privately over Tailscale. Preferred when online; the server's own Lavalink is the fallback.
# Enable with COMPOSE_PROFILES=...,home-music on the server. LAVALINK_HOME_URL is http://home-link:2333.
# Generate the password with: openssl rand -hex 32
LAVALINK_HOME_URL=
LAVALINK_HOME_PASSWORD=
# Tailscale auth key (admin console > Settings > Keys, Reusable). Used once per device to join.
TAILSCALE_AUTHKEY=

# OPTIONAL music metadata resolution (links are resolved to metadata, then matched to a playable source).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Apple Music songs and albums work with no setup. Playlists need a MusicKit key from
# developer.apple.com > Certificates, IDs & Profiles > Keys (enable "Media Services (MusicKit...)").
# The bot signs short-lived tokens from it and refreshes them itself.
#   APPLE_MUSIC_TEAM_ID      your 10-character Team ID (top right of the developer site)
#   APPLE_MUSIC_KEY_ID       the key's 10-character Key ID
#   APPLE_MUSIC_PRIVATE_KEY  the downloaded AuthKey_XXXXXXXXXX.p8 as ONE line of base64:
#                            base64 -i AuthKey_XXXXXXXXXX.p8 | tr -d '\n'
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
# Alternative to the key above: a pre-made developer token (expires after at most 6 months).
APPLE_MUSIC_DEVELOPER_TOKEN=

# OPTIONAL simple human verification challenge.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# OPTIONAL AI helper: dashboard BYOK credentials require a stable server-side encryption key.
# Set AI_ENCRYPTION_KEY to a secure 32-byte random value encoded as base64. Do not regenerate once storing keys.
AI_ENCRYPTION_KEY=
# Key rotation: bump the version when replacing the key and keep the old key in PREVIOUS ("<version>:<base64>")
# until every stored credential has been re-entered or re-saved.
AI_ENCRYPTION_KEY_VERSION=1
AI_ENCRYPTION_KEY_PREVIOUS=
# Optional bootstrap Google API key; providers and backup keys can instead be set in owner-only dashboard.
GOOGLE_API_KEY=
AI_DEFAULT_MODEL=gemini-3.5-flash-lite
AI_ESCALATION_MODEL=gemini-3.8-flash
# Use 0 for the Gemini free tier. Note: on the free tier Google may use prompts (including indexed server messages) to improve its products.
AI_MONTHLY_TARGET_USD=10

# Cloudflare Tunnel: the dashboard is published only through Cloudflare; the server opens no ports.
# Create the tunnel in Cloudflare Zero Trust > Networks > Tunnels and paste its token here.
CLOUDFLARE_TUNNEL_TOKEN=
# The visitor IP (for rate limits) comes from CF-Connecting-IP. Only set this when the tunnel is the sole way in.
TRUST_PROXY=cloudflare
# Optional docker compose services to run: tunnel (Cloudflare Tunnel), music (Lavalink).
COMPOSE_PROFILES=tunnel,music

# Runtime / operations.
NODE_ENV=development
LOG_LEVEL=info
# Bot health endpoint (GET /health) for Docker/uptime checks.
BOT_HEALTH_PORT=8081
# Development-only dashboard preview without Discord OAuth. Ignored when NODE_ENV=production. Keep false.
DASHBOARD_DEV_LOGIN=false

# Tests: a PostgreSQL server URL where the test runner may CREATE and DROP its own throwaway databases.
TEST_DATABASE_URL=
